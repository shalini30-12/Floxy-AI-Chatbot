# Copy this file to ".env" and fill in your real values. Never commit ".env".

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=floxy_new

# --- Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# --- Flask ---
FLASK_SECRET_KEY=change_this_to_a_long_random_string
DAILY_API_LIMIT=50
